									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.token) {",
									"        pm.environment.set('authToken', response.token);",
									"    }",
									"    if (response.userDetails && response.userDetails.id) {",
									"        pm.environment.set('userId', response.userDetails.id);",
									"    }",
									"}"
								],
